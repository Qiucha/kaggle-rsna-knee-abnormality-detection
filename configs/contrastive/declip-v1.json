        "512",
        "--declip-text-mask-prob",
        "0.15"
      ]
    },
    {
      "name": "declip-mv-only-frozen-seed2026",
      "purpose": "Ablation: DeCLIP Multi-View Cross-Modal Supervision only (L_MV, lambda_NN=0) on frozen backbones (BS=32, 20ep)",
      "args": [
        "--image-unfreeze-last",
        "0",
        "--text-unfreeze-last",
        "0",
        "--use-declip",
        "--declip-mv-weight",
        "1.0",
        "--declip-nn-weight",
        "0.0",
        "--declip-text-mask-prob",
        "0.15"
      ]
    },
    {
      "name": "declip-lora-depth6-r64-seed2026",
