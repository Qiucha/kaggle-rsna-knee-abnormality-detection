        "128",
        "--gradient-checkpointing",
        "--use-declip",
        "--declip-mv-weight",
        "1.0",
        "--declip-nn-weight",
        "0.5",
        "--declip-image-ss-weight",
        "0.5",
        "--declip-queue-size",
        "512",
        "--declip-text-mask-prob",
        "0.15"
      ]
    }
  ],
  "experiment_version": "declip-v1",
  "manifest_sha256": "54bd803e23acf3299daeb815d651a34249c736689e20d790f862fc71c0520b63",
