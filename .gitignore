logs/
.agents/
.claude/
skills-lock.json
digest/site/

# Cached probe features: large, and rebuilt from checkpoints by the probe scripts
digest/*.npz

# This machine's disk guards and archive mover (they assume one WSL host's Windows C:/D: disks)
scripts/archive_checkpoints.sh
scripts/disk_watchdog.sh
scripts/require_free_space.sh

# Personal Kaggle kernel metadata (account slug, private dataset)
notebooks/kernel-metadata.json

