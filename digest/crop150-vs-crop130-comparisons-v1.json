{
  "comparison_version": "gold-probe-crop150-v1-paired-arms",
  "config": {
    "EXPOSURE_CAVEAT": "BOTH arms trained on contrastive-cohort.jsonl, which contains 48 of the gold studies in train and 8 in validation. Every LEVEL produced by this config is therefore a development statistic, exposure-inflated by approximately 0.0168 of macro AUROC (gold-holdout-v1.md), and must never be quoted against the 0.6938 generalisation estimate. The paired DIFFERENCE between the two arms is a contrast between arms sharing the same exposure and is NOT corrected by that figure.",
    "PRE_REGISTERED_READING": {
      "crop150 above crop130, pooled CI excluding zero": "The wider crop helps the labels despite costing retrieval. That is a genuine dissociation and it would make crop150 the preferred preprocessing on the metric that matters clinically, even though selection remains retrieval R@1.",
      "crop150 below crop130, pooled CI excluding zero": "The wider crop hurts both retrieval AND label readout. The dilution mechanism (extra field is muscle and subcutaneous fat) is then the better-supported of the two explanations in crop150-rebaseline-v1.md.",
      "pooled CI spanning zero": "NULL on the label question. The crop change is then neither justified nor refuted by label readout, and the retrieval cost stands as the only measured effect. Given 56 studies and 8-33 positives per label, a single-arm interval runs roughly +/-0.015 to +/-0.03, so a null here is weak evidence and must be reported as underpowered rather than as 'no effect'.",
      "selection": "Selection remains retrieval R@1 throughout. Nothing is selected on label AUROC, and this result does not change which checkpoint any future arm starts from."
    },
    "REQUIRES_PER_ARM_PREPROCESSING": "This is the FIRST probe config in the project whose arms do not share one preprocessing. Before 2026-09-15 evaluate_downstream_probe.py took image_kwargs from whichever checkpoint loaded first and applied it to every arm, which would have fed one of these two arms pixels it never trained on and produced a plausible, wrong number with no error. It now extracts features once per distinct preprocessing (extract_features_by_preprocessing), verified inert on single-preprocessing configs by reproducing gold-probe-unexposed-v2's integrity assertion exactly. Do not run this config on an older revision of that script.",
    "arms": {
      "before_cl": {
        "features": [
          "uniform_mean_768"
        ],
        "image_model": "facebook/dinov2-small",
        "image_model_revision": "ed25f3a31f01632728cabb09d1542f84ab7b0056",
